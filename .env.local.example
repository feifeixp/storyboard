# OpenRouter API Key
# 获取方式：https://openrouter.ai/ → Settings → API Keys
VITE_OPENROUTER1_API_KEY=sk-or-v1-你的API密钥

# Cloudflare Workers API URL（已在 .env 中配置，这里仅作参考）
# VITE_API_URL=https://storyboard-api.feifeixp.workers.dev

# OpenAI API（用于提示词优化功能）
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Volcengine API（用于 Seedance 2.0 视频生成）
VITE_ARK_API_KEY=your-ark-api-key-here
